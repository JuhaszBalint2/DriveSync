<views:ModernWindowBase 
    x:Class="DriveSync.WPF.Views.SyncHistoryListWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:DriveSync.WPF.Localization"
    xmlns:views="clr-namespace:DriveSync.WPF.Views"
    Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SyncHistory]}"
    Height="510" 
    Width="850"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource BackgroundBrush}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="13">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SyncHistory]}"
                   Style="{DynamicResource SubheadingStyle}"
                   FontSize="20"
                   Margin="0,0,0,16"/>

        <!-- Sync History List -->
        <ListView Grid.Row="1"
                  x:Name="SyncHistoryListView"
                  ItemsSource="{Binding SyncHistory}"
                  Background="Transparent"
                  BorderThickness="0"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource HistoryItemButtonStyle}" 
                            Command="{Binding DataContext.OpenSyncHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                            CommandParameter="{Binding}">
                        <Grid Margin="12" Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" 
                                       Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                       Style="{DynamicResource BodyTextStyle}" 
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                       Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding Description}" 
                                       Style="{DynamicResource BodyTextStyle}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Close Button -->
        <Button Grid.Row="2" 
                Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Close]}"
                Style="{DynamicResource ButtonBaseStyle}"
                MinWidth="102"
                Width="Auto"
                Padding="10,6"
                Height="32"
                HorizontalAlignment="Right"
                Margin="0,13,0,0"
                Click="CloseButton_Click"/>
    </Grid>
</views:ModernWindowBase>