<views:ModernWindowBase 
    x:Class="DriveSync.WPF.Views.LogViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:DriveSync.WPF.Localization"
    xmlns:views="clr-namespace:DriveSync.WPF.Views"
    Title="Sync Log" 
    Height="510" 
    Width="850"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    Background="{DynamicResource BackgroundBrush}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="13">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,13">
            <TextBlock Text="Sync Operation Log"
                      Style="{DynamicResource SubheadingStyle}"
                      FontSize="15"
                      DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" 
                        DockPanel.Dock="Right" 
                        HorizontalAlignment="Right"
                        Margin="13,0,0,0">
                <Button x:Name="CopyButton"
                        Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CopyLog]}"
                        Style="{DynamicResource ButtonBaseStyle}"
                        MinWidth="102"
                        Width="Auto"
                        Height="32"
                        Padding="10,6"
                        Margin="0,0,7,0"
                        Click="CopyButton_Click"/>

                <Button x:Name="ExportButton"
                        Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Export]}"
                        Style="{DynamicResource ButtonBaseStyle}"
                        MinWidth="102"
                        Width="Auto"
                        Height="32"
                        Padding="10,6"
                        Click="ExportButton_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Log Content -->
        <ScrollViewer Grid.Row="1"
                     x:Name="LogScroller"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     Background="{DynamicResource SurfaceBrush}"
                     BorderBrush="{DynamicResource BorderDefaultBrush}"
                     BorderThickness="1">
            <TextBlock x:Name="LogTextBlock"
                      FontFamily="Consolas"
                      FontSize="11"
                      Padding="10"
                      TextWrapping="NoWrap"
                      Foreground="{DynamicResource TextPrimaryBrush}"/>
        </ScrollViewer>

        <!-- Footer -->
        <DockPanel Grid.Row="2" 
                   Margin="0,13,0,0"
                   LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock x:Name="OperationCountText"
                          Style="{DynamicResource BodyTextStyle}"
                          FontSize="12"
                          Margin="0,0,13,0"/>
                <TextBlock x:Name="TimestampText"
                          Style="{DynamicResource BodyTextStyle}"
                          FontSize="12"/>
            </StackPanel>
            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Close]}"
                    Style="{DynamicResource ButtonBaseStyle}"
                    MinWidth="102"
                    Width="Auto"
                    Height="32"
                    Padding="10,6"
                    DockPanel.Dock="Right"
                    Click="CloseButton_Click"/>
        </DockPanel>
    </Grid>
</views:ModernWindowBase>