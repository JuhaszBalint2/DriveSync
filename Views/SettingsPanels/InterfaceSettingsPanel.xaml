<UserControl x:Class="DriveSync.WPF.Views.SettingsPanels.InterfaceSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DriveSync.WPF.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <StackPanel>
        <!-- Theme Settings Section -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AppearanceHeader]}"
                           Style="{DynamicResource SubheadingStyle}"
                           Margin="0,0,0,16"/>

                <!-- Theme Mode -->
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeMode]}"
                           Style="{DynamicResource BodyTextStyle}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <ComboBox x:Name="ThemeCombo"
                          Height="36"
                          Width="240"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,16">
                    <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[System]}"/>
                    <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Light]}"/>
                    <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Dark]}"/>
                </ComboBox>

                <!-- UI Scaling -->
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[FontSettings]}"
                           Style="{DynamicResource BodyTextStyle}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <Grid Width="240"
                      HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[FontSize]}"
                               Style="{DynamicResource BodyTextStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <TextBox x:Name="FontSizeTextBox"
                             Grid.Column="1"
                             Height="36"
                             VerticalContentAlignment="Center"
                             ToolTip="Font size (8-72)"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Language Settings Section -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Language]}"
                           Style="{DynamicResource SubheadingStyle}"
                           Margin="0,0,0,16"/>
                <ComboBox x:Name="LanguageCombo"
                          Height="36"
                          Width="240"
                          HorizontalAlignment="Left">
                    <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[English]}"/>
                    <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Hungarian]}"/>
                </ComboBox>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LanguageNoteRestart]}"
                           Style="{DynamicResource BodyTextStyle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>