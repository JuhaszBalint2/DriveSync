<UserControl x:Class="DriveSync.WPF.Views.SettingsPanels.SecuritySettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DriveSync.WPF.Localization">
    <StackPanel>
        <!-- Authentication Section -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Authentication]}"
                           Style="{DynamicResource SubheadingStyle}"
                           Margin="0,0,0,16"/>

                <CheckBox x:Name="RequirePasswordCheckBox"
                          Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[RequirePasswordOnStartup]}"
                          Margin="0,0,0,12"/>

                <CheckBox x:Name="RequirePasswordForSettingsCheckBox"
                          Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[RequirePasswordForSettings]}"
                          Margin="0,0,0,12"/>

                <CheckBox x:Name="RequirePasswordForSyncCheckBox"
                          Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[RequirePasswordForManualSync]}"
                          Margin="0,0,0,12"/>

                <!-- Transfer Security Section -->
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TransferSecurity]}"
                           Style="{DynamicResource SubheadingStyle}"
                           Margin="0,16,0,12"/>

                <CheckBox x:Name="VerifyChecksumCheckBox"
                          Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VerifyChecksumFlag]}"
                          ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VerifyChecksumTooltip]}"
                          Margin="0,0,0,12"/>

                <CheckBox x:Name="CompareModTimeCheckBox"
                          Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CompareModTimeFlag]}"
                          ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CompareModTimeTooltip]}"
                          Margin="0,0,0,12"/>

                <CheckBox x:Name="VerifyTransfersCheckBox"
                          Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VerifyTransfersFlag]}"
                          ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VerifyTransfersTooltip]}"
                          Margin="0,0,0,12"/>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SecurityPerformanceNote]}"
                           Style="{DynamicResource BodyTextStyle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>