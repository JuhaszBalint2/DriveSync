<UserControl x:Class="DriveSync.WPF.Views.SettingsPanels.PerformanceSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DriveSync.WPF.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <Style x:Key="CenteredComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,0,0"/>
        </Style>

        <Style x:Key="CenteredComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,0,0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CenteredComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="border"
                                Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"/>

                            <ToggleButton Grid.ColumnSpan="2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" BorderThickness="0"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Grid.Column="0"
                                        IsHitTestVisible="False"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                            <Path Grid.Column="1"
                                  x:Name="arrow"
                                  Data="M0,0 L4,4 L8,0 Z"
                                  Fill="{DynamicResource TextPrimaryBrush}"
                                  Width="8"
                                  Height="4"
                                  Margin="0,0,8,0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup"
                                   Grid.ColumnSpan="2"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder"
                                        MinWidth="{Binding ActualWidth, ElementName=border}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ListItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                                <Setter TargetName="arrow" Property="Data" Value="M0,4 L4,0 L8,4 Z"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Transfer Settings Group -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TransferSettings]}"
                           Style="{DynamicResource SubheadingStyle}"
                           Margin="0,0,0,16"/>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ParallelTransfers]}"
                           Style="{DynamicResource BodyTextStyle}"
                           Margin="0,0,0,8"/>
                <ComboBox x:Name="TransfersTextBox"
                         Height="28"
                         Width="70"
                         Style="{StaticResource CenteredComboBoxStyle}"
                         ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ParallelTransfersTooltip]}"
                         HorizontalAlignment="Left">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="8"/>
                    <ComboBoxItem Content="12"/>
                    <ComboBoxItem Content="16"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="24"/>
                    <ComboBoxItem Content="28"/>
                    <ComboBoxItem Content="32"/>
                </ComboBox>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CheckWorkers]}"
                           Style="{DynamicResource BodyTextStyle}"
                           Margin="0,16,0,8"/>
                <ComboBox x:Name="CheckersTextBox"
                         Height="28"
                         Width="70"
                         Style="{StaticResource CenteredComboBoxStyle}"
                         ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CheckWorkersTooltip]}"
                         HorizontalAlignment="Left">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="8"/>
                    <ComboBoxItem Content="16"/>
                    <ComboBoxItem Content="24"/>
                    <ComboBoxItem Content="32"/>
                    <ComboBoxItem Content="48"/>
                    <ComboBoxItem Content="56"/>
                    <ComboBoxItem Content="64"/>
                </ComboBox>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BufferSize]}"
                           Style="{DynamicResource BodyTextStyle}"
                           Margin="0,16,0,8"/>
                <ComboBox x:Name="BufferSizeTextBox"
                         Height="28"
                         Width="80"
                         Style="{StaticResource CenteredComboBoxStyle}"
                         ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BufferSizeTooltip]}"
                         HorizontalAlignment="Left">
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="8"/>
                    <ComboBoxItem Content="16"/>
                    <ComboBoxItem Content="32"/>
                    <ComboBoxItem Content="64"/>
                    <ComboBoxItem Content="128"/>
                    <ComboBoxItem Content="256"/>
                    <ComboBoxItem Content="512"/>
                    <ComboBoxItem Content="768"/>
                    <ComboBoxItem Content="1024"/>
                </ComboBox>

                <CheckBox x:Name="UseMemoryMappingCheckBox"
                          Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[UseMemoryMapping]}"
                          ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[UseMemoryMappingTooltip]}"
                          Margin="0,16,0,0"/>
            </StackPanel>
        </Border>

        <!-- Bandwidth Control -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BandwidthControl]}"
                           Style="{DynamicResource SubheadingStyle}"
                           Margin="0,0,0,16"/>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BandwidthLimitMiBs]}"
                           Style="{DynamicResource BodyTextStyle}"
                           Margin="0,0,0,8"/>
                <ComboBox x:Name="BandwidthLimitTextBox"
                         Height="28"
                         Width="80"
                         Style="{StaticResource CenteredComboBoxStyle}"
                         ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BandwidthLimitTooltip]}"
                         HorizontalAlignment="Left">
                    <ComboBoxItem Content="0"/>
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="50"/>
                    <ComboBoxItem Content="100"/>
                    <ComboBoxItem Content="200"/>
                    <ComboBoxItem Content="500"/>
                </ComboBox>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CutoffMode]}"
                           Style="{DynamicResource BodyTextStyle}"
                           Margin="0,16,0,8"/>
                <ComboBox x:Name="CutoffModeCombo"
                          Height="28"
                          Width="110"
                          Style="{StaticResource CenteredComboBoxStyle}"
                          ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CutoffModeTooltip]}"
                          HorizontalAlignment="Left">
                    <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CutoffModeHard]}"/>
                    <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CutoffModeSoft]}"/>
                </ComboBox>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>