<UserControl x:Class="DriveSync.WPF.Views.SettingsPanels.SyncSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DriveSync.WPF.Localization">
    <StackPanel>
        <!-- Sync Behavior Section -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SyncBehavior]}"
                           Style="{DynamicResource SubheadingStyle}"
                           Margin="0,0,0,16"/>

                <CheckBox x:Name="DeleteEmptyDirsCheckBox"
                          Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DeleteEmptySourceDirsFlag]}"
                          ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DeleteEmptySourceDirsTooltip]}"
                          Margin="0,0,0,12"/>

                <CheckBox x:Name="IgnoreExistingCheckBox"
                          Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[IgnoreExistingFlag]}"
                          ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[IgnoreExistingTooltip]}"
                          Margin="0,0,0,12"/>

                <CheckBox x:Name="CompareSizeCheckBox"
                          Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CompareSizeOnlyFlag]}"
                          ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CompareSizeOnlyTooltip]}"
                          Margin="0,0,0,12"/>

                <CheckBox x:Name="PreservePermissionsCheckBox"
                          Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PreservePermissionsFlag]}"
                          ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PreservePermissionsTooltip]}"
                          Margin="0,0,0,12"/>

                <CheckBox x:Name="PreserveTimestampsCheckBox"
                          Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PreserveTimestampsFlag]}"
                          ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PreserveTimestampsTooltip]}"
                          Margin="0,0,0,12"/>
            </StackPanel>
        </Border>

        <!-- File Filtering Section -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[FileFiltering]}"
                           Style="{DynamicResource SubheadingStyle}"
                           Margin="0,0,0,16"/>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ExcludedPaths]}"
                           Style="{DynamicResource BodyTextStyle}"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="ExcludedPathsTextBox"
                         Height="28"
                         Width="400"
                         HorizontalAlignment="Left"
                         ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ExcludedPathsTooltip]}"/>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AllowedPaths]}"
                           Style="{DynamicResource BodyTextStyle}"
                           Margin="0,16,0,8"/>

                <TextBox x:Name="IncludedPathsTextBox"
                         Height="28"
                         Width="400"
                         HorizontalAlignment="Left"
                         ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AllowedPathsTooltip]}"/>

                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[FilterSyntaxNote]}"
                           Style="{DynamicResource BodyTextStyle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>