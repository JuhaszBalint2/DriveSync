<UserControl x:Class="DriveSync.WPF.Views.SettingsPanels.AdvancedSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DriveSync.WPF.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <StackPanel>
        <!-- Error Handling and Retry Section -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ErrorHandling]}"
                           Style="{DynamicResource SubheadingStyle}"
                           Margin="0,0,0,16"/>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[RetryCount]}"
                           Style="{DynamicResource BodyTextStyle}"
                           Margin="0,0,0,8"/>
                <ComboBox x:Name="RetryCountTextBox"
                         Height="28"
                         Width="200"
                         HorizontalAlignment="Left"
                         ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[RetryCountTooltip]}">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="7"/>
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="15"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="25"/>
                    <ComboBoxItem Content="30"/>
                </ComboBox>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ConnectionTimeout]}"
                           Style="{DynamicResource BodyTextStyle}"
                           Margin="0,16,0,8"/>
                <ComboBox x:Name="ConnectTimeoutTextBox"
                         Height="28"
                         Width="200"
                         HorizontalAlignment="Left"
                         ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ConnectionTimeoutTooltip]}">
                    <ComboBoxItem Content="30"/>
                    <ComboBoxItem Content="60"/>
                    <ComboBoxItem Content="120"/>
                    <ComboBoxItem Content="180"/>
                    <ComboBoxItem Content="300"/>
                    <ComboBoxItem Content="600"/>
                    <ComboBoxItem Content="900"/>
                    <ComboBoxItem Content="1200"/>
                    <ComboBoxItem Content="1800"/>
                    <ComboBoxItem Content="3600"/>
                </ComboBox>
            </StackPanel>
        </Border>
        <!-- Advanced Transfer Options -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedTransferOptions]}"
                           Style="{DynamicResource SubheadingStyle}"
                           Margin="0,0,0,16"/>
                <CheckBox x:Name="FastListCheckBox"
                          Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[UseFastList]}"
                          ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[FastListTooltip]}"
                          Margin="0,0,0,12"/>
                <CheckBox x:Name="NoTraversalCheckBox"
                          Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DisableDirectoryTraversal]}"
                          ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DisableDirectoryTraversalTooltip]}"
                          Margin="0,0,0,12"/>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PerformanceWarning]}"
                           Style="{DynamicResource BodyTextStyle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>