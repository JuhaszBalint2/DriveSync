<views:ModernWindowBase 
    x:Class="DriveSync.WPF.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:DriveSync.WPF.Localization"
    xmlns:views="clr-namespace:DriveSync.WPF.Views"
    xmlns:converters="clr-namespace:DriveSync.WPF.Converters"
    Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ApplicationSettings]}"
    Height="595"
    Width="850"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource BackgroundBrush}">

    <views:ModernWindowBase.Resources>
        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Padding" Value="7,3"/>
        </Style>

        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Padding" Value="7,3"/>
        </Style>

        <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Padding" Value="7,3"/>
        </Style>

        <Style x:Key="SettingsBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="17"/>
            <Setter Property="Margin" Value="0,0,0,17"/>
        </Style>

        <Style x:Key="SettingsGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,17"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </views:ModernWindowBase.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Panel -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Header -->
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ApplicationSettings]}"
                           DockPanel.Dock="Top"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Margin="17,17,17,17"/>

                <!-- Navigation Items -->
                <ListBox x:Name="SettingsNavigation"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0"
                         SelectionChanged="SettingsNavigation_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Height" Value="34"/>
                            <Setter Property="Padding" Value="17,0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="0"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" TargetName="Bd" Value="{DynamicResource ListItemHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" TargetName="Bd" Value="{DynamicResource ListItemSelectedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBoxItem>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PanelGeneral]}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="12"/>
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PanelInterface]}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="12"/>
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PanelSync]}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="12"/>
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PanelPerformance]}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="12"/>
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PanelAdvanced]}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="12"/>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Column="1" Margin="0">
            <!-- Settings Content -->
            <Grid x:Name="SettingsContent" Margin="27">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Settings Header -->
                <TextBlock x:Name="SettingsHeader"
                           Grid.Row="0"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,17"/>

                <!-- Settings Panel Container -->
                <ScrollViewer Grid.Row="1"
                             Margin="0,0,0,17"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SettingsPanels"/>
                </ScrollViewer>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="2" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           Margin="0,17,0,0">
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Reset]}"
                            Style="{DynamicResource ButtonBaseStyle}"
                            MinWidth="102"
                            Height="28"
                            Padding="8,4"
                            Margin="0,0,8,0"
                            Click="ResetButton_Click"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Cancel]}"
                            Style="{DynamicResource ButtonBaseStyle}"
                            MinWidth="102"
                            Height="28"
                            Padding="8,4"
                            Margin="0,0,8,0"
                            Click="CancelButton_Click"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SaveSettings]}"
                            Style="{DynamicResource ButtonBaseStyle}"
                            MinWidth="102"
                            Height="28"
                            Padding="8,4"
                            Click="SaveButton_Click"
                            Background="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</views:ModernWindowBase>