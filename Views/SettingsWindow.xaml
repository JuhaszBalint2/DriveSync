<views:ModernWindowBase 
    x:Class="DriveSync.WPF.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:DriveSync.WPF.Localization"
    xmlns:views="clr-namespace:DriveSync.WPF.Views"
    xmlns:converters="clr-namespace:DriveSync.WPF.Converters"
    Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ApplicationSettings]}"
    Height="700"
    Width="1000"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Panel -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Header -->
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ApplicationSettings]}"
                           DockPanel.Dock="Top"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="20,24,20,24"/>

                <!-- Navigation Items -->
                <ListBox x:Name="SettingsNavigation"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0"
                         SelectionChanged="SettingsNavigation_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="Padding" Value="20,0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="0"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" TargetName="Bd" Value="{DynamicResource ListItemHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" TargetName="Bd" Value="{DynamicResource ListItemSelectedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBoxItem>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PanelGeneral]}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="14"/>
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PanelInterface]}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="14"/>
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PanelSecurity]}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="14"/>
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PanelSync]}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="14"/>
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PanelPerformance]}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="14"/>
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PanelAdvanced]}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="14"/>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Column="1" Margin="0">
            <!-- Settings Content -->
            <Grid x:Name="SettingsContent" Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Settings Header -->
                <TextBlock x:Name="SettingsHeader"
                           Grid.Row="0"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="0,0,0,24"/>

                <!-- Settings Panel Container -->
                <ScrollViewer Grid.Row="1"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SettingsPanels"/>
                </ScrollViewer>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="2" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           Margin="0,24,0,0">
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Reset]}"
                            Style="{DynamicResource ButtonBaseStyle}"
                            MinWidth="120"
                            Height="32"
                            Margin="0,0,12,0"
                            Click="ResetButton_Click"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Cancel]}"
                            Style="{DynamicResource ButtonBaseStyle}"
                            MinWidth="120"
                            Height="32"
                            Margin="0,0,12,0"
                            Click="CancelButton_Click"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SaveSettings]}"
                            Style="{DynamicResource ButtonBaseStyle}"
                            MinWidth="120"
                            Height="32"
                            Click="SaveButton_Click"
                            Background="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</views:ModernWindowBase>