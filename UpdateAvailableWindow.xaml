<Window x:Class="DriveSync.WPF.Views.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DriveSync.WPF.Converters"
        xmlns:loc="clr-namespace:DriveSync.WPF.Localization"
        Title="Rclone Update" 
        Height="350" 
        Width="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True">
    <Window.Resources>
        <converters:ProgressToWidthConverter x:Key="ProgressToWidthConverter"/>
    </Window.Resources>
    <Border Background="{DynamicResource BackgroundBrush}" 
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                               Opacity="0.3" 
                               BlurRadius="20" 
                               ShadowDepth="2" 
                               Direction="-90"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="CountdownTextBlock"
                       Text="{Binding CountdownMessage}"
                       Style="{DynamicResource BodyTextStyle}"
                       FontSize="14"
                       TextAlignment="Center"
                       Margin="0,0,0,16"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Grid.Row="0"/>

            <StackPanel x:Name="LocalizationPanel" 
                        Grid.Row="1" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="Select Language / Válasszon nyelvet"
                           Style="{DynamicResource SubheadingStyle}"
                           FontSize="18"
                           TextAlignment="Center"
                           Margin="0,0,0,24"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="English" 
                            Style="{DynamicResource ButtonBaseStyle}"
                            Click="LanguageButton_Click"
                            Tag="English"
                            Margin="0,0,16,0"
                            Padding="16,8"/>

                    <Button Content="Magyar" 
                            Style="{DynamicResource ButtonBaseStyle}"
                            Click="LanguageButton_Click"
                            Tag="Hungarian"
                            Padding="16,8"/>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="UpdatePanel" 
                        Grid.Row="1" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center">
                <TextBlock Text="{Binding UpdateMessage}"
                           Style="{DynamicResource BodyTextStyle}"
                           FontSize="16"
                           TextAlignment="Center"
                           Margin="0,0,0,24"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>

                <Border Background="{DynamicResource SurfaceBrush}" 
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <ProgressBar x:Name="DownloadProgressBar" 
                                 IsIndeterminate="True" 
                                 Height="12">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Border Background="Transparent" 
                                                    CornerRadius="6">
                                                <Border x:Name="PART_Indicator" 
                                                        Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="6"
                                                        HorizontalAlignment="Left">
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource ProgressToWidthConverter}">
                                                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                            <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </Border>

                <TextBlock x:Name="SubtitleTextBlock"
                           Text="Please wait while DriveSync prepares the update..."
                           Style="{DynamicResource BodyTextStyle}"
                           FontSize="14"
                           Margin="0,16,0,0"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>