<Window x:Class="DriveSync.WPF.Views.DirectoryBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:DriveSync.WPF.Localization"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SelectDirectory]}" 
        Height="450" 
        Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Header -->
        <TextBlock Text="{Binding DialogTitle}" 
                   Style="{DynamicResource SubheadingStyle}"
                   Margin="0,0,0,16"/>
        <!-- Directory List -->
        <Border Grid.Row="1" 
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                Background="{DynamicResource SurfaceBrush}"
                Margin="0,0,0,16">
            <Grid>
                <ListView x:Name="DirectoryList"
                          BorderThickness="0"
                          Background="Transparent"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          ItemContainerStyle="{DynamicResource DarkThemeListViewItem}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       Padding="8,4"
                                       Style="{DynamicResource BodyTextStyle}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!-- Loading Overlay -->
                <Grid Background="#80FFFFFF"
                      Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" 
                                     Width="32" 
                                     Height="32"
                                     Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LoadingDirectories]}"
                                   Style="{DynamicResource BodyTextStyle}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <!-- Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Cancel]}"
                    Style="{DynamicResource ButtonBaseStyle}"
                    MinWidth="120"
                    Width="Auto"
                    Padding="12,0"
                    Height="28"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"/>
            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Select]}"
                    Style="{DynamicResource ButtonBaseStyle}"
                    MinWidth="120"
                    Width="Auto"
                    Padding="12,0"
                    Height="28"
                    IsEnabled="{Binding HasSelection}"
                    Click="SelectButton_Click"/>
        </StackPanel>
    </Grid>
</Window>