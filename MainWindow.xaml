<views:ModernWindowBase 
    x:Class="DriveSync.WPF.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DriveSync.WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:DriveSync.WPF.ViewModels"
    xmlns:loc="clr-namespace:DriveSync.WPF.Localization"
    xmlns:views="clr-namespace:DriveSync.WPF.Views"
    mc:Ignorable="d"
    Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ApplicationTitle]}"
    SizeToContent="Manual"
    Height="637"
    Width="935"
    MinHeight="500"
    MinWidth="800"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource BackgroundBrush}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Action Bar -->
        <Grid Grid.Row="0" 
              Background="{DynamicResource PrimaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ApplicationTitle]}"
                       Grid.Column="0"
                       Style="{DynamicResource HeadingStyle}"
                       Foreground="White"
                       FontSize="24"
                       VerticalAlignment="Center"
                       Margin="17,12"/>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right"
                        Margin="17,12">
                <!-- Sync Button -->
                <Button Content="{Binding ButtonText}"
                        Command="{Binding SyncCommand}"
                        Style="{DynamicResource ButtonBaseStyle}"
                        IsEnabled="{Binding IsValid}"
                        MinWidth="102"
                        Height="32"
                        Padding="10,6"
                        Margin="0,0,8,0"/>
                <!-- Schedule Button -->
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Schedule]}"
                        Command="{Binding ScheduleSyncCommand}"
                        Style="{DynamicResource ButtonBaseStyle}"
                        MinWidth="102"
                        Height="32"
                        Padding="10,6"
                        Margin="0,0,8,0"/>

                <ComboBox x:Name="LanguageComboBox"
                         MinWidth="85"
                         Height="32"
                         FontFamily="Segoe UI"
                         FontSize="13"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem Content="English" 
                                 IsSelected="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=CurrentLanguage, Converter={StaticResource EnglishSelectedConverter}}"/>
                    <ComboBoxItem Content="Magyar" 
                                 IsSelected="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=CurrentLanguage, Converter={StaticResource HungarianSelectedConverter}}"/>
                </ComboBox>

                <!-- Settings Button -->
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings]}"
                        Command="{Binding OpenSettingsCommand}"
                        Style="{DynamicResource ButtonBaseStyle}"
                        MinWidth="102"
                        Height="32"
                        Padding="10,6"/>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Sync Configuration Area -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Sync Configuration Panel -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="7"
                        Padding="17"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        Margin="0,0,13,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SyncConfiguration]}"
                                 Style="{DynamicResource SubheadingStyle}"
                                 FontSize="20"
                                 Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Source Panel -->
                            <DockPanel Grid.Column="0" Margin="0,0,7,0">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Source]}"
                                         Style="{DynamicResource BodyTextStyle}"
                                         FontSize="13"
                                         DockPanel.Dock="Top"
                                         Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding AvailableRemotes}"
                                        SelectedItem="{Binding SelectedSourceRemote}"
                                        Height="32"
                                        DockPanel.Dock="Top"
                                        FontSize="13"
                                        Margin="0,0,0,8"/>
                                <Grid DockPanel.Dock="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Browse]}"
                                            Command="{Binding BrowseSourceCommand}"
                                            Style="{DynamicResource ButtonBaseStyle}"
                                            MinWidth="102"
                                            Height="32"
                                            Padding="10,6"
                                            Grid.Column="0"
                                            Margin="0,0,8,0"/>

                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="1"
                                            Height="32"
                                            CornerRadius="4">
                                        <TextBlock Text="{Binding SourcePath}"
                                                 ToolTip="{Binding SourcePath}"
                                                 VerticalAlignment="Center"
                                                 Margin="8,0"
                                                 FontSize="13"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 TextWrapping="NoWrap"
                                                 TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </DockPanel>

                            <!-- Arrow -->
                            <TextBlock Grid.Column="1"
                                     Text="➔"
                                     FontSize="24"
                                     VerticalAlignment="Top"
                                     Margin="13,32"
                                     Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <!-- Target Panel -->
                            <DockPanel Grid.Column="2" Margin="7,0,0,0">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Target]}"
                                         Style="{DynamicResource BodyTextStyle}"
                                         FontSize="13"
                                         DockPanel.Dock="Top"
                                         Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding AvailableRemotes}"
                                        SelectedItem="{Binding SelectedTargetRemote}"
                                        Height="32"
                                        DockPanel.Dock="Top"
                                        FontSize="13"
                                        Margin="0,0,0,8"/>
                                <Grid DockPanel.Dock="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Browse]}"
                                            Command="{Binding BrowseTargetCommand}"
                                            Style="{DynamicResource ButtonBaseStyle}"
                                            MinWidth="102"
                                            Height="32"
                                            Padding="10,6"
                                            Grid.Column="0"
                                            Margin="0,0,8,0"/>
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="1"
                                            Height="32"
                                            CornerRadius="4"
                                            Padding="7,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TargetPath}"
                                                 ToolTip="{Binding TargetPath}"
                                                 VerticalAlignment="Center"
                                                 Margin="8,0"
                                                 FontSize="13"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 TextWrapping="NoWrap"
                                                 TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </DockPanel>
                        </Grid>

                        <!-- Sync Mode Selection -->
                        <DockPanel LastChildFill="False" 
                                 Margin="0,24,0,0">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SyncMode]}"
                                     Style="{DynamicResource BodyTextStyle}"
                                     FontSize="13"
                                     VerticalAlignment="Center"
                                     DockPanel.Dock="Left"
                                     Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding AvailableSyncModes}"
                                    SelectedItem="{Binding SelectedSyncMode}"
                                    Width="200"
                                    Height="32"
                                    FontSize="13"
                                    DockPanel.Dock="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"
                                                 FontSize="13"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Sync History Panel -->
                <Border Grid.Column="1"
        Background="{DynamicResource SurfaceBrush}"
        CornerRadius="7"
        Padding="17"
        BorderBrush="{DynamicResource BorderDefaultBrush}"
        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                 Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SyncHistory]}"
                 Style="{DynamicResource SubheadingStyle}"
                 FontSize="20"
                 Margin="0,0,0,16"/>

                        <ListView Grid.Row="1"
                 ItemsSource="{Binding SyncHistory}"
                 Background="Transparent"
                 BorderThickness="0"
                 Margin="0,0,0,0"
                 Padding="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="Border"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="{TemplateBinding Margin}">
                                                    <ContentPresenter Margin="0"
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource ListItemHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource ListItemSelectedBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource HistoryItemButtonStyle}" 
                Command="{Binding DataContext.OpenSyncHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                CommandParameter="{Binding}">
                                        <Grid Margin="12" Background="Transparent">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" 
                           Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                           Style="{DynamicResource BodyTextStyle}" 
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           Margin="0,0,0,4"/>

                                            <TextBlock Grid.Row="1"
                           Text="{Binding Description}" 
                           Style="{DynamicResource BodyTextStyle}"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" 
                           TextWrapping="Wrap"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Progress Section -->
            <Grid Grid.Row="1" 
                  Margin="20,0,20,13" 
                  Visibility="{Binding IsSyncing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                         Text="{Binding CurrentSyncOperation}"
                         Style="{DynamicResource BodyTextStyle}"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1"
                         Text="{Binding CurrentFile}"
                         Style="{DynamicResource BodyTextStyle}"
                         FontSize="13"
                         Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2"
                         Text="{Binding ProgressPercentage, StringFormat='{}{0} complete'}"
                         Style="{DynamicResource BodyTextStyle}"
                         FontSize="13"
                         Margin="0,0,0,4"/>

                <ProgressBar Grid.Row="3"
                           Value="{Binding ProgressValue}"
                           Height="12"
                           Margin="0,0,0,8"
                           Minimum="0"
                           Maximum="100"
                           SnapsToDevicePixels="True"/>

                <StackPanel Grid.Row="4"
                          Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentSpeed}"
                             Style="{DynamicResource BodyTextStyle}"
                             FontSize="13"
                             Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding RemainingTime}"
                             Style="{DynamicResource BodyTextStyle}"
                             FontSize="13"/>
                </StackPanel>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Height="32"
                    SnapsToDevicePixels="True">
                <DockPanel LastChildFill="False" 
                          Margin="8,0">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="{Binding StatusIndicatorBrush}"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             SnapsToDevicePixels="True"/>

                    <TextBlock Text="{Binding StatusMessage}"
                             Style="{DynamicResource BodyTextStyle}"
                             FontSize="13"
                             VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding UpdateMessage}"
                             Style="{DynamicResource BodyTextStyle}"
                             FontSize="13"
                             VerticalAlignment="Center"
                             Margin="16,0,0,0"
                             DockPanel.Dock="Right"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</views:ModernWindowBase>