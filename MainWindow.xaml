<views:ModernWindowBase 
    x:Class="DriveSync.WPF.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DriveSync.WPF.Converters"
    xmlns:fa="http://schemas.fontawesome.io/icons/"
    xmlns:fas="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:DriveSync.WPF.ViewModels"
    xmlns:loc="clr-namespace:DriveSync.WPF.Localization"
    xmlns:views="clr-namespace:DriveSync.WPF.Views"
    mc:Ignorable="d"
    Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ApplicationTitle]}"
    SizeToContent="Manual"
    Height="637"
    Width="935"
    MinHeight="500"
    MinWidth="800"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource BackgroundBrush}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <views:ModernWindowBase.Resources>
        <Style x:Key="SyncOperationIconStyle" TargetType="fas:IconBlock">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="24"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=Background.Color}" Value="#303030">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=Background.Color}" Value="#FAFAFA">
                    <Setter Property="Foreground" Value="#0078D4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="SecondaryInfoIconStyle" TargetType="fas:IconBlock">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=Background.Color}" Value="#303030">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=Background.Color}" Value="#FAFAFA">
                    <Setter Property="Foreground" Value="#0078D4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryInfoTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=Background.Color}" Value="#303030">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=Background.Color}" Value="#FAFAFA">
                    <Setter Property="Foreground" Value="#0078D4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </views:ModernWindowBase.Resources>



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" 
              Background="{DynamicResource PrimaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ApplicationTitle]}"
                       Grid.Column="0"
                       Style="{DynamicResource HeadingStyle}"
                       Foreground="White"
                       FontSize="24"
                       VerticalAlignment="Center"
                       Margin="17,12"/>

            <StackPanel Grid.Column="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right"
                        Margin="17,12">
                <Button Content="{Binding ButtonText}"
                        Command="{Binding SyncCommand}"
                        Style="{DynamicResource ButtonBaseStyle}"
                        IsEnabled="{Binding IsValid}"
                        MinWidth="102"
                        Height="32"
                        Padding="10,6"
                        Margin="0,0,8,0"/>

                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Schedule]}"
                        Command="{Binding ScheduleSyncCommand}"
                        Style="{DynamicResource ButtonBaseStyle}"
                        MinWidth="102"
                        Height="32"
                        Padding="10,6"
                        Margin="0,0,8,0"/>

                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SyncHistory]}"
                        Command="{Binding OpenSyncHistoryListCommand}"
                        Style="{DynamicResource ButtonBaseStyle}"
                        MinWidth="102"
                        Height="32"
                        Padding="10,6"
                        Margin="0,0,8,0"/>

                <ComboBox x:Name="LanguageComboBox"
                         MinWidth="85"
                         Height="32"
                         FontFamily="Segoe UI"
                         FontSize="13"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem Content="English" 
                                 IsSelected="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=CurrentLanguage, Converter={StaticResource EnglishSelectedConverter}}"/>
                    <ComboBoxItem Content="Magyar" 
                                 IsSelected="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=CurrentLanguage, Converter={StaticResource HungarianSelectedConverter}}"/>
                </ComboBox>

                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings]}"
                        Command="{Binding OpenSettingsCommand}"
                        Style="{DynamicResource ButtonBaseStyle}"
                        MinWidth="102"
                        Height="32"
                        Padding="10,6"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="20">
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="7"
                    Padding="17"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SyncConfiguration]}"
                              Style="{DynamicResource SubheadingStyle}"
                              FontSize="20"
                              Margin="0,0,0,16"
                              Grid.Row="0"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0" Margin="0,0,7,0">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Source]}"
                                     Style="{DynamicResource BodyTextStyle}"
                                     FontSize="13"
                                     DockPanel.Dock="Top"
                                     Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding AvailableRemotes}"
                                    SelectedItem="{Binding SelectedSourceRemote}"
                                    Height="32"
                                    DockPanel.Dock="Top"
                                    FontSize="13"
                                    Margin="0,0,0,8"/>
                            <Grid DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Browse]}"
                                        Command="{Binding BrowseSourceCommand}"
                                        Style="{DynamicResource ButtonBaseStyle}"
                                        MinWidth="102"
                                        Height="32"
                                        Padding="10,6"
                                        Grid.Column="0"
                                        Margin="0,0,8,0"/>

                                <Border Grid.Column="1"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="1"
                                        Height="32"
                                        CornerRadius="4">
                                    <TextBlock Text="{Binding SourcePath}"
                                             ToolTip="{Binding SourcePath}"
                                             VerticalAlignment="Center"
                                             Margin="8,0"
                                             FontSize="13"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             TextWrapping="NoWrap"
                                             TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </DockPanel>

                        <TextBlock Grid.Column="1"
                                     Text="➔"
                                     FontSize="24"
                                     VerticalAlignment="Top"
                                     Margin="13,32"
                                     Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <DockPanel Grid.Column="2" Margin="7,0,0,0">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Target]}"
                                     Style="{DynamicResource BodyTextStyle}"
                                     FontSize="13"
                                     DockPanel.Dock="Top"
                                     Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding AvailableRemotes}"
                                    SelectedItem="{Binding SelectedTargetRemote}"
                                    Height="32"
                                    DockPanel.Dock="Top"
                                    FontSize="13"
                                    Margin="0,0,0,8"/>
                            <Grid DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Browse]}"
                                        Command="{Binding BrowseTargetCommand}"
                                        Style="{DynamicResource ButtonBaseStyle}"
                                        MinWidth="102"
                                        Height="32"
                                        Padding="10,6"
                                        Grid.Column="0"
                                        Margin="0,0,8,0"/>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="1"
                                        Height="32"
                                        CornerRadius="4"
                                        Padding="7,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TargetPath}"
                                             ToolTip="{Binding TargetPath}"
                                             VerticalAlignment="Center"
                                             Margin="8,0"
                                             FontSize="13"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             TextWrapping="NoWrap"
                                             TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Grid>

                    <DockPanel Grid.Row="3" 
                             LastChildFill="False">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SyncMode]}"
                                 Style="{DynamicResource BodyTextStyle}"
                                 FontSize="13"
                                 VerticalAlignment="Center"
                                 DockPanel.Dock="Left"
                                 Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding AvailableSyncModes}"
                                SelectedItem="{Binding SelectedSyncMode}"
                                Width="200"
                                Height="32"
                                FontSize="13"
                                DockPanel.Dock="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName, Converter={StaticResource LocalizationConverter}}"
                                             FontSize="13"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>

                    <Border Grid.Row="5" 
        Background="{DynamicResource BackgroundBrush}"
        BorderBrush="{DynamicResource BorderDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="24">
                        <Grid>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[WaitingForSync]}"
                  Style="{DynamicResource BodyTextStyle}"
                  FontSize="14"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Visibility="{Binding IsSyncing, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                            <Grid Visibility="{Binding IsSyncing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" 
                      Margin="0,0,0,20"
                      LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Left" 
                          Orientation="Horizontal"
                          VerticalAlignment="Center">
                                        <fas:IconBlock Icon="{Binding CurrentFile, Converter={StaticResource SyncOperationIconConverter}}"
                                 Style="{StaticResource SyncOperationIconStyle}"/>
                                        <TextBlock Text="{Binding CurrentFile, Converter={StaticResource JsonOperationConverter}}"
                                                  Style="{StaticResource SecondaryInfoTextStyle}"
                                                  FontSize="16"
                                                  FontWeight="SemiBold"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding ProgressPercentage}"
                         Style="{DynamicResource BodyTextStyle}"
                         FontSize="14"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Margin="0,0,0,8"/>
                                </DockPanel>

                                <StackPanel Grid.Row="1" 
                                            Orientation="Horizontal"
                                            Margin="30,0,0,16">
                                    <fas:IconBlock Icon="File" 
                                                   Style="{StaticResource SecondaryInfoIconStyle}"/>
                                    <TextBlock Text="{Binding CurrentFile, Converter={StaticResource JsonFilenameConverter}}" 
                                               Style="{StaticResource SecondaryInfoTextStyle}"
                                               FontWeight="SemiBold"/>
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" 
            Background="{DynamicResource BackgroundBrush}"
            CornerRadius="8"
            Height="14"
            Margin="0,0,0,16">
                                        <Border.Effect>
                                            <DropShadowEffect ShadowDepth="1" 
                        BlurRadius="4" 
                        Opacity="0.1"/>
                                        </Border.Effect>
                                        <Grid>
                                            <ProgressBar Value="{Binding ProgressValue}"
             Maximum="100"
             Minimum="0"
             Height="14"
             Background="Transparent"
             BorderThickness="0">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ProgressBar">
                                                                    <Grid>
                                                                        <Border x:Name="PART_Track"
                                    Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="7"/>
                                                                        <Border x:Name="PART_Indicator"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="7"
                                    HorizontalAlignment="Left">
                                                                            <Border.Width>
                                                                                <MultiBinding>
                                                                                    <MultiBinding.Converter>
                                                                                        <converters:ProgressToWidthConverter/>
                                                                                    </MultiBinding.Converter>
                                                                                    <Binding Path="Value" 
                                                 RelativeSource="{RelativeSource TemplatedParent}"/>
                                                                                    <Binding Path="Minimum" 
                                                 RelativeSource="{RelativeSource TemplatedParent}"/>
                                                                                    <Binding Path="Maximum" 
                                                 RelativeSource="{RelativeSource TemplatedParent}"/>
                                                                                    <Binding Path="ActualWidth" 
                                                 RelativeSource="{RelativeSource TemplatedParent}"/>
                                                                                </MultiBinding>
                                                                            </Border.Width>
                                                                        </Border>
                                                                    </Grid>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" 
                                                    Orientation="Horizontal"
                                                    Margin="0,0,0,0">
                                            <fas:IconBlock Icon="Bolt"
                                                           Style="{StaticResource SecondaryInfoIconStyle}"/>
                                            <TextBlock Text="{Binding CurrentSpeed}"
                                                       Style="{StaticResource SecondaryInfoTextStyle}"
                                                       Margin="4,0,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,0">
                                            <fas:IconBlock Icon="Calendar" 
                                                           Style="{StaticResource SecondaryInfoIconStyle}"/>
                                            <TextBlock Text="{Binding CurrentFile, Converter={StaticResource JsonTimestampConverter}}"
                                                       Style="{StaticResource SecondaryInfoTextStyle}"
                                                       Margin="4,0,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                   Orientation="Horizontal"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,0,0">
                                            <fas:IconBlock Icon="Clock" 
                                                          Style="{StaticResource SecondaryInfoIconStyle}"/>
                                            <TextBlock Text="{Binding RemainingTime}"
                                                      Style="{StaticResource SecondaryInfoTextStyle}"
                                                      Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" 
          Background="{DynamicResource SurfaceBrush}"
          Height="24">
            <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,0,20,0">
                <TextBlock Text="{Binding UpdateMessage}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="10"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,10,0"/>

                <TextBlock Text="{Binding RcloneVersion, StringFormat='Rclone v{0}'}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="10"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</views:ModernWindowBase>