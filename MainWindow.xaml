<views:ModernWindowBase 
    x:Class="DriveSync.WPF.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DriveSync.WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:DriveSync.WPF.ViewModels"
    xmlns:loc="clr-namespace:DriveSync.WPF.Localization"
    xmlns:views="clr-namespace:DriveSync.WPF.Views"
    mc:Ignorable="d"
    Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ApplicationTitle]}"
    Height="637"
    Width="935"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Action Bar -->
        <Grid Grid.Row="0" 
              Background="{DynamicResource PrimaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ApplicationTitle]}"
                       Grid.Column="0"
                       Style="{DynamicResource HeadingStyle}"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="17,8"/>

            <StackPanel Grid.Column="2" 
            Orientation="Horizontal" 
            HorizontalAlignment="Right"
            Margin="17,8">
                <Button Content="{Binding ButtonText}"
            Command="{Binding SyncCommand}"
            Style="{DynamicResource ButtonBaseStyle}"
            IsEnabled="{Binding IsValid}"
            MinWidth="102"
            Width="Auto"
            Height="28"
            Padding="10,4"
            Margin="0,0,8,0"/>
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Schedule]}"
            Command="{Binding ScheduleSyncCommand}"
            Style="{DynamicResource ButtonBaseStyle}"
            MinWidth="102"
            Width="Auto"
            Height="28"
            Padding="10,4"
            Margin="0,0,8,0"/>
                <ComboBox x:Name="LanguageComboBox"
              MinWidth="85"
              Width="Auto"
              Height="28"
              FontFamily="Segoe UI"
              FontSize="12"
              Margin="0,0,8,0"
              SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem Content="English" 
                      IsSelected="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=CurrentLanguage, Converter={StaticResource EnglishSelectedConverter}}"/>
                    <ComboBoxItem Content="Magyar" 
                      IsSelected="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=CurrentLanguage, Converter={StaticResource HungarianSelectedConverter}}"/>
                </ComboBox>
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings]}"
            Command="{Binding OpenSettingsCommand}"
            Style="{DynamicResource ButtonBaseStyle}"
            MinWidth="102"
            Width="Auto"
            Height="28"
            Padding="10,4"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Sync Configuration Area -->
            <Grid Grid.Row="0" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Sync Configuration Panel -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="7"
                        Padding="17"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        Margin="0,0,13,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SyncConfiguration]}"
                                   Style="{DynamicResource SubheadingStyle}"
                                   Margin="0,0,0,13"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Source Panel -->
                            <DockPanel Grid.Column="0" Margin="0,0,7,0">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Source]}"
                                           Style="{DynamicResource BodyTextStyle}"
                                           DockPanel.Dock="Top"
                                           Margin="0,0,0,7"/>
                                <ComboBox ItemsSource="{Binding AvailableRemotes}"
                                          SelectedItem="{Binding SelectedSourceRemote}"
                                          Height="29"
                                          DockPanel.Dock="Top"
                                          Margin="0,0,0,7"/>
                                <Grid DockPanel.Dock="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Browse]}"
                                            Command="{Binding BrowseSourceCommand}"
                                            Style="{DynamicResource ButtonBaseStyle}"
                                            MinWidth="102"
                                            Width="Auto"
                                            Padding="10,0"
                                            Height="24"
                                            Grid.Column="0"
                                            Margin="0,0,7,0"/>

                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="1"
                                            Height="24"
                                            CornerRadius="3"
                                            Padding="7,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SourcePath}"
                                                   ToolTip="{Binding SourcePath}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                            </DockPanel>

                            <!-- Arrow -->
                            <TextBlock Grid.Column="1"
                                       Text="➔"
                                       FontSize="24"
                                       VerticalAlignment="Top"
                                       Margin="13,27"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <!-- Target Panel -->
                            <DockPanel Grid.Column="2" Margin="7,0,0,0">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Target]}"
                                           Style="{DynamicResource BodyTextStyle}"
                                           DockPanel.Dock="Top"
                                           Margin="0,0,0,7"/>
                                <ComboBox ItemsSource="{Binding AvailableRemotes}"
                                          SelectedItem="{Binding SelectedTargetRemote}"
                                          Height="29"
                                          DockPanel.Dock="Top"
                                          Margin="0,0,0,7"/>
                                <Grid DockPanel.Dock="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Browse]}"
                                            Command="{Binding BrowseTargetCommand}"
                                            Style="{DynamicResource ButtonBaseStyle}"
                                            MinWidth="102"
                                            Width="Auto"
                                            Padding="10,0"
                                            Height="24"
                                            Grid.Column="0"
                                            Margin="0,0,7,0"/>

                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="1"
                                            Height="24"
                                            CornerRadius="3"
                                            Padding="7,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TargetPath}"
                                                   ToolTip="{Binding TargetPath}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                            </DockPanel>
                        </Grid>

                        <!-- Sync Mode Selection -->
                        <DockPanel LastChildFill="False" 
                                   Margin="0,20,0,0">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SyncMode]}"
                                       Style="{DynamicResource BodyTextStyle}"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left"
                                       Margin="0,0,7,0"/>
                            <ComboBox ItemsSource="{Binding AvailableSyncModes}"
                                      SelectedItem="{Binding SelectedSyncMode}"
                                      Width="187"
                                      Height="29"
                                      FontFamily="Segoe UI"
                                      FontSize="12"
                                      DockPanel.Dock="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" 
                                                   FontFamily="Segoe UI" 
                                                   FontSize="12"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Sync History Panel -->
                <Border Grid.Column="1"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="7"
                        Padding="17"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SyncHistory]}"
                                   Style="{DynamicResource SubheadingStyle}"
                                   Margin="0,0,0,13"/>

                        <ListView Grid.Row="1"
                                  ItemsSource="{Binding SyncHistory}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenSyncHistoryItemCommand,
                                                             RelativeSource={RelativeSource AncestorType=views:ModernWindowBase}}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource HistoryItemButtonStyle}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch">
                                        <StackPanel Margin="3">
                                            <TextBlock Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                                       Style="{DynamicResource BodyTextStyle}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Style="{DynamicResource BodyTextStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Progress Section -->
            <Grid Grid.Row="1" 
                  Margin="20,0,20,13" 
                  Visibility="{Binding IsSyncing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding CurrentSyncOperation}"
                           Style="{DynamicResource BodyTextStyle}"
                           Margin="0,0,0,3"/>
                <TextBlock Grid.Row="1"
                           Text="{Binding CurrentFile}"
                           Style="{DynamicResource BodyTextStyle}"
                           Margin="0,0,0,7"/>
                <TextBlock Grid.Row="2"
                           Text="{Binding ProgressPercentage, StringFormat='{}{0} complete'}"
                           Style="{DynamicResource BodyTextStyle}"
                           Margin="0,0,0,3"/>
                <ProgressBar Grid.Row="3"
                             Value="{Binding ProgressValue}"
                             Height="17"
                             Margin="0,0,0,7"
                             Minimum="0"
                             Maximum="100"/>
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentSpeed}"
                               Style="{DynamicResource BodyTextStyle}"
                               Margin="0,0,13,0"/>
                    <TextBlock Text="{Binding RemainingTime}"
                               Style="{DynamicResource BodyTextStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="7">
                <DockPanel LastChildFill="False">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="{Binding StatusIndicatorBrush}"
                             Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{DynamicResource BodyTextStyle}"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="7">
                <DockPanel LastChildFill="False">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="{Binding StatusIndicatorBrush}"
                             Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{DynamicResource BodyTextStyle}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding UpdateMessage}"
                               Style="{DynamicResource BodyTextStyle}"
                               VerticalAlignment="Center"
                               Margin="13,0,0,0"
                               DockPanel.Dock="Right"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</views:ModernWindowBase>